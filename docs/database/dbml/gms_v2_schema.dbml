// ============================================================
// GMS - Gym Management System | THIET KE MUC TIEU (v2) | 19 bang | SQL Server 2022
// Nguon: DATABASE_SCHEMA.md (Agent 1, 2026-10-12), doi chieu voi USER_STORIES.md
//
// THAY DOI SO VOI DB DANG CHAY (CHUA trien khai):
//  CH1 payment_transactions: bo cap related_type/related_id (khong co khoa ngoai) -> 2 cot FK
//      member_package_id, pos_order_id; user_id cho phep NULL (khach vang lai mua le)
//  CH2 gym_check_ins (MOI): luot vao phong tap khong gan buoi PT
//  CH3 user_profiles: age -> date_of_birth
//  CH4 users: bo avatar_url (trung user_profiles.avatar_url)
//  CH5 pos_order_items.subtotal va pos_orders.total_amount: bo (suy ra duoc)
// Lien ket logic khong co FK cung: trainer_schedules <-> bookings (theo trainer_id + ngay + gio)
// ============================================================

Project gms {
  Note: 'GMS - Gym Management System. SQL Server 2022, khoa chinh UNIQUEIDENTIFIER (NEWID()), timestamp DATETIME2 (SYSUTCDATETIME()). Enum trang thai luu VARCHAR, khong dung CHECK.'
}

// ---------------- V1 - Agent 1 ----------------

Table roles [headercolor: #4A6B94] {
  id uniqueidentifier [pk, default: `NEWID()`]
  name varchar(50) [not null, unique, note: '5 gia tri: SUPER_ADMIN, RECEPTIONIST, TRAINER, SALES, MEMBER']
  description nvarchar(255) [null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table users [headercolor: #4A6B94] {
  id uniqueidentifier [pk, default: `NEWID()`]
  full_name nvarchar(150) [not null]
  email varchar(150) [not null, unique]
  phone varchar(20) [null, unique, note: 'UNIQUE tren cot nullable: SQL Server chi cho 1 dong NULL (van de da biet, DATABASE_SCHEMA.md muc 4 #1)']
  password_hash varchar(255) [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE / INACTIVE / BANNED']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table user_roles [headercolor: #4A6B94] {
  user_id uniqueidentifier [not null]
  role_id uniqueidentifier [not null]

  indexes {
    (user_id, role_id) [pk]
  }
}

Table branches [headercolor: #4A6B94] {
  id uniqueidentifier [pk, default: `NEWID()`]
  name nvarchar(150) [not null]
  address nvarchar(255) [null]
  phone varchar(20) [null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE / CLOSED']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

// ---------------- V2_1 - Agent 1 ----------------

Table user_profiles [headercolor: #4A6B94] {
  id uniqueidentifier [pk, default: `NEWID()`]
  user_id uniqueidentifier [not null, unique]
  date_of_birth date [null, note: 'Tuoi tinh tu ngay sinh, khong luu tuoi. Validate >= 18 so voi users.created_at']
  weight_kg decimal(5,2) [null]
  height_cm decimal(5,2) [null]
  goal nvarchar(255) [null]
  avatar_url varchar(255) [null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

// ---------------- V2 / V2_2 - Agent 2 ----------------

Table packages [headercolor: #4A6B94] {
  id uniqueidentifier [pk, default: `NEWID()`]
  name nvarchar(150) [not null]
  description nvarchar(500) [null]
  price decimal(12,2) [not null]
  duration_days int [null]
  session_count int [null]
  package_type varchar(20) [not null, note: 'TIME_BASED / SESSION_BASED / PT_1ON1']
  peak_type varchar(20) [not null, default: 'FULL_TIME', note: 'OFF_PEAK / FULL_TIME']
  max_sessions_per_week int [null, note: 'NULL = khong gioi han; 0 = khong cho dat PT; N = toi da N buoi/tuan']
  is_active bit [not null, default: 1]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table member_packages [headercolor: #4A6B94] {
  id uniqueidentifier [pk, default: `NEWID()`]
  user_id uniqueidentifier [not null]
  package_id uniqueidentifier [not null]
  branch_id uniqueidentifier [null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / ACTIVE / EXPIRED / SCHEDULED / CANCELLED. Goi hien tai = ban ghi ACTIVE duy nhat']
  start_date date [not null]
  end_date date [null]
  remaining_sessions int [null, note: 'Tru 1 khi booking chot COMPLETED / MEMBER_NO_SHOW / LATE_CANCEL']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table payment_transactions [headercolor: #4A6B94] {
  id uniqueidentifier [pk, default: `NEWID()`]
  user_id uniqueidentifier [null, note: 'Nguoi tra tien. NULL = khach vang lai mua le tai quay']
  member_package_id uniqueidentifier [null, note: 'Thanh toan goi tap (FK member_packages)']
  pos_order_id uniqueidentifier [null, note: 'Thanh toan don ban le (FK pos_orders)']
  amount decimal(12,2) [not null]
  payment_method varchar(20) [not null, note: 'CASH / LOCAL_CONFIRM']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / SUCCESS / FAILED']
  transaction_code varchar(100) [not null, unique, note: 'Dung cho idempotency']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]

  Note: 'CHECK: dung 1 trong 2 cot member_package_id / pos_order_id co gia tri (thay cho cap related_type + related_id khong co khoa ngoai)'
}

// ---------------- V3 - Agent 3 (nhanh rieng, chua merge) ----------------

Table trainer_schedules [headercolor: #B7791F] {
  id uniqueidentifier [pk, default: `NEWID()`]
  trainer_id uniqueidentifier [not null]
  work_date date [not null, note: 'Ngay cu the, khong phai thu lap lai hang tuan']
  start_time time [not null]
  end_time time [not null]
  is_active bit [not null, default: 1, note: '0 = ca tam nghi']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [not null, default: `SYSUTCDATETIME()`]
}

Table bookings [headercolor: #B7791F] {
  id uniqueidentifier [pk, default: `NEWID()`]
  member_id uniqueidentifier [not null]
  trainer_id uniqueidentifier [not null]
  branch_id uniqueidentifier [null]
  booking_date date [not null]
  start_time time [not null]
  end_time time [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / CONFIRMED / COMPLETED / CANCELLED / NO_SHOW / PT_NO_SHOW / LATE_CANCELLED']
  check_in_time datetime2 [null, note: 'Hoc vien quet mat vao']
  check_in_method varchar(20) [null, note: 'FACE']
  check_out_time datetime2 [null, note: 'Hoc vien quet mat ra']
  check_out_method varchar(20) [null, note: 'FACE']
  pt_check_in_time datetime2 [null, note: 'PT quet mat vao']
  pt_check_in_method varchar(20) [null, note: 'FACE']
  pt_check_out_time datetime2 [null, note: 'PT quet mat ra']
  pt_check_out_method varchar(20) [null, note: 'FACE']
  pt_early_leave_reason nvarchar(255) [null, note: 'Ly do PT ra som; trong = khong day du gio -> khong tinh luong']
  notes nvarchar(500) [null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [not null, default: `SYSUTCDATETIME()`]
}

// ---------------- V4 - Agent 4 (nhanh rieng, chua merge) ----------------

Table face_profiles [headercolor: #B7791F] {
  id uniqueidentifier [pk, default: `NEWID()`]
  user_id uniqueidentifier [not null, unique]
  descriptor nvarchar(max) [not null, note: 'JSON array 128 so thuc (vector dac trung khuon mat)']
  reference_image varchar(255) [null, note: 'Anh goc lam bang chung, khong dung de so khop']
  registered_by uniqueidentifier [null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table staff_attendances [headercolor: #B7791F] {
  id uniqueidentifier [pk, default: `NEWID()`]
  staff_id uniqueidentifier [not null]
  "date" date [not null]
  check_in_time datetime2 [null]
  check_out_time datetime2 [null]
  method varchar(20) [not null, default: 'MANUAL', note: 'MANUAL / FACE']
  notes nvarchar(255) [null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]

  indexes {
    (staff_id, "date") [unique]
  }
}

Table gym_check_ins [headercolor: #C0392B] {
  id uniqueidentifier [pk, default: `NEWID()`]
  member_id uniqueidentifier [not null]
  branch_id uniqueidentifier [null]
  check_in_time datetime2 [not null]
  check_out_time datetime2 [null, note: 'Lan quet thu 2 trong ngay = check-out']
  method varchar(20) [not null, default: 'FACE', note: 'FACE / MANUAL']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]

  Note: 'MOI: luot vao phong tap, khong gan voi buoi PT. Dung cho lich su check-in cua hoi vien va bao cao luu luong'
}

// ---------------- V5 - Agent 5 (thiet ke, chua co migration) ----------------

Table products [headercolor: #7B5EA7] {
  id uniqueidentifier [pk, default: `NEWID()`]
  name nvarchar(150) [not null]
  category varchar(50) [not null, note: 'DRINK / SUPPLEMENT / ACCESSORY']
  price decimal(12,2) [not null]
  stock_quantity int [not null, default: 0]
  unit nvarchar(20) [null]
  is_active bit [not null, default: 1]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table pos_orders [headercolor: #7B5EA7] {
  id uniqueidentifier [pk, default: `NEWID()`]
  member_id uniqueidentifier [null, note: 'NULL = khach vang lai']
  staff_id uniqueidentifier [not null]
  branch_id uniqueidentifier [null]
  payment_method varchar(20) [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'De xuat: PENDING / COMPLETED / CANCELLED (Agent 5 xac nhan)']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table pos_order_items [headercolor: #7B5EA7] {
  id uniqueidentifier [pk, default: `NEWID()`]
  order_id uniqueidentifier [not null]
  product_id uniqueidentifier [not null]
  quantity int [not null, note: '> 0']
  unit_price decimal(12,2) [not null, note: 'Gia tai thoi diem ban']
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table trainer_pay_rates [headercolor: #7B5EA7] {
  id uniqueidentifier [pk, default: `NEWID()`]
  trainer_id uniqueidentifier [not null, unique, note: '1 PT 1 muc luong']
  amount_per_session decimal(12,2) [not null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

Table commissions [headercolor: #7B5EA7] {
  id uniqueidentifier [pk, default: `NEWID()`]
  staff_id uniqueidentifier [not null, note: 'Chi con PT (hoa hong Sales da bo)']
  booking_id uniqueidentifier [not null, unique, note: 'Moi buoi toi da 1 ban ghi (chong tinh hai lan)']
  outcome varchar(20) [not null, note: 'COMPLETED / MEMBER_NO_SHOW / LATE_CANCEL']
  amount decimal(12,2) [not null, note: 'Lay tu trainer_pay_rates tai thoi diem chot buoi']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / PAID']
  paid_at datetime2 [null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

// ---------------- V6 - Agent 6 (thiet ke, chua co migration) ----------------

Table leads [headercolor: #7B5EA7] {
  id uniqueidentifier [pk, default: `NEWID()`]
  full_name nvarchar(150) [not null]
  phone varchar(20) [not null]
  source nvarchar(50) [null]
  status varchar(20) [not null, default: 'NEW', note: 'NEW / CONTACTED / CONVERTED / LOST']
  assigned_sales_id uniqueidentifier [null]
  converted_user_id uniqueidentifier [null, note: 'Set khi CONVERTED']
  notes nvarchar(500) [null]
  created_at datetime2 [not null, default: `SYSUTCDATETIME()`]
  updated_at datetime2 [null]
}

// ============================================================
// QUAN HE (24 khoa ngoai). Mac dinh ON DELETE NO ACTION,
// chi 3 cho CASCADE: user_roles, user_profiles, pos_order_items.
// ============================================================

Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: user_profiles.user_id - users.id [delete: cascade]

Ref: member_packages.user_id > users.id
Ref: member_packages.package_id > packages.id
Ref: member_packages.branch_id > branches.id
Ref: payment_transactions.user_id > users.id

Ref: trainer_schedules.trainer_id > users.id
Ref: bookings.member_id > users.id
Ref: bookings.trainer_id > users.id
Ref: bookings.branch_id > branches.id

Ref: face_profiles.user_id - users.id
Ref: face_profiles.registered_by > users.id
Ref: staff_attendances.staff_id > users.id

Ref: pos_orders.member_id > users.id
Ref: pos_orders.staff_id > users.id
Ref: pos_orders.branch_id > branches.id
Ref: pos_order_items.order_id > pos_orders.id [delete: cascade]
Ref: pos_order_items.product_id > products.id
Ref: trainer_pay_rates.trainer_id - users.id
Ref: commissions.staff_id > users.id
Ref: commissions.booking_id - bookings.id

Ref: leads.assigned_sales_id > users.id
Ref: leads.converted_user_id > users.id
Ref: gym_check_ins.member_id > users.id
Ref: gym_check_ins.branch_id > branches.id
Ref: payment_transactions.member_package_id > member_packages.id
Ref: payment_transactions.pos_order_id > pos_orders.id
