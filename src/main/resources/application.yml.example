spring:
  application:
    name: gym-management-system

  datasource:
    url: jdbc:sqlserver://localhost:1433;databaseName=gms_db;encrypt=true;trustServerCertificate=true
    username: sa
    password: "GmsStrongP@ss123"
    driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver

  jpa:
    hibernate:
      ddl-auto: validate   # Flyway quản lý schema, JPA chỉ validate
    properties:
      hibernate:
        format_sql: true
    show-sql: false

  flyway:
    enabled: true
    baseline-on-migrate: true
    locations: classpath:db/migration

  data:
    redis:
      host: localhost
      port: 6379
      password: ""

  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 6MB

server:
  port: 8080

springdoc:
  swagger-ui:
    path: /swagger-ui.html
  api-docs:
    path: /v3/api-docs

# ==== Cấu hình riêng GMS ====
gms:
  jwt:
    secret: "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
    access-token-expiration-ms: 900000        # 15 phút
    refresh-token-expiration-ms: 604800000    # 7 ngày

  upload:
    dir: uploads                              # thư mục lưu file upload (avatar, ảnh sản phẩm...), phục vụ qua /uploads/**

  booking:
    min-lead-time-minutes: 30                 # không cho đặt lịch cách hiện tại dưới 30 phút
    pending-timeout-minutes: 60                # PENDING quá 60 phút chưa xác nhận -> tự CANCELLED
    pt-no-show-grace-minutes: 30               # CONFIRMED quá 30 phút giờ hẹn chưa hoàn thành -> PT_NO_SHOW

  face-attendance:
    match-threshold: 0.45                     # ngưỡng khoảng cách Euclidean tối đa để coi là khớp (đã kiểm chứng thực tế)

  vietqr:
    client-id: "CHANGE_ME"
    api-key: "CHANGE_ME"
    base-url: "https://api.vietqr.io"

  momo:
    partner-code: "CHANGE_ME"
    access-key: "CHANGE_ME"
    secret-key: "CHANGE_ME"
    endpoint: "CHANGE_ME"
    return-url: "CHANGE_ME"
    ipn-url: "CHANGE_ME"

  zalo-zns:
    app-id: "CHANGE_ME"
    secret-key: "CHANGE_ME"
    template-id: "CHANGE_ME"

  sms-brandname:
    api-key: "CHANGE_ME"
    brandname: "GYM-GMS"

logging:
  level:
    com.gym.management: DEBUG
    org.springframework.security: INFO
